# Absolute host path to a root-owned, dedicated-group-readable mode-0440 JSON
# file. Compose bind-mounts it and gives the non-root API process only this
# supplementary numeric group. This value is not the secret content.
MYFIN_PAYMENT_GATEWAY_SECRET_FILE=/srv/myfin/secrets/payment-gateway-credentials.json
MYFIN_PAYMENT_GATEWAY_SECRET_GID=19000
