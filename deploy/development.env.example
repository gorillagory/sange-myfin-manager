# Copy outside Git; values below contain no credentials. Source into the shell
# only after review. Secrets are protected files readable by API UID 1000.
MYFIN_COMPOSE_PROJECT=myfin-dev
AUTH_BASE_URL=https://dev-pos.bayam.live
AUTH_ALLOWED_HOSTS=dev-pos.bayam.live,order-dev.bayam.live
AUTH_CONTROL_HOSTS=
# Optional post-enrollment smoke target. It must be an exact storefront_hosts
# record before scripts/deploy/smoke.sh runs.
MYFIN_STOREFRONT_HOST=order-dev.bayam.live
# Leave empty in the protected file. up.sh replaces it for the API process with
# the exact current web container IP; never put a browser or tunnel IP here.
PUBLIC_PROXY_ADDRESSES=
TENANT_HOST_ENFORCEMENT=true
MYFIN_WEB_BIND_IP=192.168.1.100
MYFIN_WEB_PORT=8083
MYFIN_API_IMAGE=myfin-api:phase02
MYFIN_WEB_IMAGE=myfin-web:phase02
MYFIN_DB_NAME=myfin_dev
MYFIN_DB_USER=myfin_dev_runtime
MYFIN_DB_PASSWORD_FILE=/srv/docker/apps/sange-myfin-manager-private/runtime.secret
MYFIN_AUTH_SECRET_FILE=/srv/docker/apps/sange-myfin-manager-private/auth.secret
MYFIN_POS_CODE_SECRET_FILE=/srv/docker/apps/sange-myfin-manager-private/pos-code.secret
MYFIN_POS_SESSION_SECRET_FILE=/srv/docker/apps/sange-myfin-manager-private/pos-session.secret
MYFIN_MIGRATOR_PASSWORD_FILE=/srv/docker/apps/sange-myfin-manager-private/migrator.secret
MYFIN_UPLOAD_VOLUME=myfin-dev-uploads
