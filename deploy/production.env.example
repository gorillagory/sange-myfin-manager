# Copy outside Git. Production has separate database roles, secrets, uploads,
# network identity, Compose project and host port from development.
MYFIN_COMPOSE_PROJECT=myfin-prod
AUTH_BASE_URL=https://admin.finn3.com
AUTH_ALLOWED_HOSTS=*.finn3.com
AUTH_CONTROL_HOSTS=admin.finn3.com
PUBLIC_ROOT_DOMAIN=finn3.com
TENANT_HOST_ENFORCEMENT=true
MYFIN_WEB_BIND_IP=192.168.1.100
MYFIN_WEB_PORT=8084
MYFIN_API_IMAGE=myfin-api:phase06
MYFIN_WEB_IMAGE=myfin-web:phase06
MYFIN_DB_NAME=myfin_prod
MYFIN_DB_USER=myfin_prod_runtime
MYFIN_DB_PASSWORD_FILE=/srv/docker/secrets/myfin-prod/db.secret
MYFIN_AUTH_SECRET_FILE=/srv/docker/secrets/myfin-prod/auth.secret
MYFIN_POS_CODE_SECRET_FILE=/srv/docker/secrets/myfin-prod/pos-code.secret
MYFIN_POS_SESSION_SECRET_FILE=/srv/docker/secrets/myfin-prod/pos-session.secret
MYFIN_MIGRATOR_PASSWORD_FILE=/srv/docker/secrets/myfin-prod/migrator.secret
MYFIN_UPLOAD_VOLUME=myfin-prod-uploads
